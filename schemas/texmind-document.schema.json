{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://texmind.local/schemas/texmind-document.schema.json",
  "title": "TexMind intermediate document",
  "description": "Dữ liệu trung gian giữa bước trích xuất nội dung và bước render tài liệu.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "document_type",
    "language",
    "template",
    "source",
    "header",
    "title",
    "legal_bases",
    "enactment",
    "articles",
    "data_tables",
    "recipients",
    "signature",
    "legal_effect",
    "provenance",
    "quality"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sample_id": { "type": "string", "pattern": "^[a-z]{2}_[0-9]{3}$" },
    "document_type": { "type": "string", "enum": ["quyet_dinh"] },
    "language": { "const": "vi" },
    "template": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "dataset", "license", "input_file", "preserve_original_content"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "input_file": { "type": "string", "minLength": 1 },
        "preserve_original_content": { "const": true }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "national_heading", "motto", "document_number", "issue_place", "issue_date", "issue_date_text"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1 },
        "national_heading": { "type": "string", "minLength": 1 },
        "motto": { "type": "string", "minLength": 1 },
        "document_number": { "type": "string", "minLength": 1 },
        "issue_place": { "type": "string", "minLength": 1 },
        "issue_date": { "type": "string", "format": "date" },
        "issue_date_text": { "type": "string", "minLength": 1 }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_name", "subject"],
      "properties": {
        "document_name": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 }
      }
    },
    "legal_bases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "enactment": { "type": "string", "minLength": 1 },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/article" }
    },
    "data_tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/data_table" }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment" }
    },
    "recipients": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "delegation", "position", "signed_status", "signer_name"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "delegation": { "type": ["string", "null"], "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "signed_status": { "type": "string", "minLength": 1 },
        "signer_name": { "type": "string", "minLength": 1 }
      }
    },
    "legal_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from", "supersedes", "review_note"],
      "properties": {
        "effective_from": { "type": "string", "format": "date" },
        "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "review_note": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizations", "source_anomalies"],
      "properties": {
        "normalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_text", "normalized_text", "reason"],
            "properties": {
              "source_text": { "type": "string" },
              "normalized_text": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "source_anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_text", "note"],
            "properties": {
              "source_text": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_status", "content_status", "legal_review_status"],
      "properties": {
        "extraction_status": { "enum": ["verified"] },
        "content_status": { "enum": ["source_preserved"] },
        "legal_review_status": { "enum": ["not_expert_reviewed", "expert_reviewed"] },
        "source_consistency": { "enum": ["passed", "warning"] },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "heading", "clauses", "related_table_ids"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array",
          "items": { "$ref": "#/$defs/clause" }
        },
        "related_table_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "text"],
      "properties": {
        "number": { "type": ["string", "null"], "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/clause" } }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_reference", "included_in_source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_reference": { "type": "string", "minLength": 1 },
        "included_in_source": { "type": "boolean" }
      }
    },
    "money_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_text", "value_vnd"],
      "properties": {
        "source_text": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{3}$" },
        "value_vnd": { "type": "integer", "minimum": 0 }
      }
    },
    "data_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "title", "unit", "columns", "rows"],
      "properties": {
        "table_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "description", "minimum_rent", "maximum_rent"],
            "properties": {
              "group": { "type": "integer", "minimum": 1 },
              "description": { "type": "string", "minLength": 1 },
              "minimum_rent": { "$ref": "#/$defs/money_value" },
              "maximum_rent": { "$ref": "#/$defs/money_value" }
            }
          }
        }
      }
    }
  }
}
